{
  "name": "rapidjam-configurator",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev:setup": "node scripts/configure-worktree.mjs",
    "dev:show": "node scripts/show-dev-config.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:parallel": "node scripts/serve-parallel.mjs",
    "serve": "node server.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare-tauri-dev.mjs && tauri dev --config src-tauri/tauri.dev.local.conf.json",
    "tauri:build": "tauri build",
    "release:check": "node scripts/check-release-metadata.mjs .",
    "test:dev-config": "node --test scripts/dev-config.test.mjs",
    "test:hall-travel": "node --experimental-strip-types --test tests/calibrationMath.test.ts tests/calibrationCapture.test.ts tests/hallInputEstimate.test.ts tests/hallLiveReadCoordinator.test.ts tests/liveReadingState.test.ts tests/settingMode.test.ts tests/strokeProfiles.test.ts",
    "test:button-labels": "node --experimental-strip-types --test tests/buttonLabels.test.ts",
    "test:hardware-labels": "node --experimental-strip-types --test tests/hardwareLabels.test.ts",
    "test:button-face": "node --experimental-strip-types --test tests/buttonFaceTuning.test.ts tests/buttonFaceTuningValidation.test.ts",
    "test:button-face-svg": "node --experimental-strip-types --test tests/buttonFaceSvg.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
